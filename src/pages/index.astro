---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage1 from '../assets/hero-image1.jpg';
import heroImage2 from '../assets/hero-image2.jpg';
---

<BaseLayout>
    <!-- Hero Section -->
    <main class="relative max-w-7xl mx-auto px-6 pt-32 lg:pt-24 pb-16 lg:pb-8 lg:min-h-screen lg:flex lg:flex-col lg:justify-center">
      <div class="editorial-asymmetric-grid items-center scroll-mt-24 lg:scroll-mt-28" id="home">
        <!-- Main editorial spread -->
        <div class="grid gap-8 lg:grid-cols-[minmax(12rem,0.7fr)_minmax(18rem,1.3fr)] items-center animate-fade-in-up">
          <div class="flex flex-col items-start">
            <span class="editorial-tag editorial-tag--accent mb-6">
              Infrastructure / DevOps<span class="hidden lg:contents"> · Portfolio issue 01 / 2026</span>
            </span>
            <h1 class="editorial-display text-slate-900 mb-7">
              Reza<br />Hakim<br /><span class="marker">Arafah</span>
            </h1>
            <p class="text-slate-700 text-base leading-relaxed max-w-xs mb-6 font-medium">
              Personal portfolio &amp; infrastructure learning lab untuk Linux,
              networking, otomasi, Docker, dan arsitektur sistem.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="editorial-tag">Linux</span>
              <span class="editorial-tag">Docker</span>
              <span class="editorial-tag">Python</span>
            </div>
          </div>

          <div class="mac-window w-full hidden lg:block" id="hero-terminal">
            <div class="mac-titlebar">
              <div class="mac-traffic-lights" aria-hidden="true">
                <span class="mac-dot mac-dot--close" title="Close"></span>
                <span class="mac-dot mac-dot--minimize" title="Minimize"></span>
                <span class="mac-dot mac-dot--maximize" title="Maximize"></span>
              </div>
              <div class="font-mono text-[11px] font-medium text-[#86868b] tracking-wide">root@infralab — zsh</div>
              <div class="w-[52px]"></div>
            </div>
            <div class="p-5 font-mono text-[11px] leading-relaxed text-[#1d1d1f] h-80 lg:h-96 mac-terminal-body overflow-hidden" id="terminal-body">
              <div class="text-[#007aff] font-semibold mb-1">Welcome to InfraLab Interactive Shell v2.0</div>
              <div class="text-[#86868b] mb-3">Initializing system lab environment... [OK]</div>
              <div id="typewriter"></div>
            </div>
          </div>
        </div>

        <!-- Latest / profile index -->
        <aside class="glass-panel rounded-2xl p-6 reveal" aria-label="Latest profile details">
          <p class="font-mono text-[11px] font-bold tracking-[0.14em] text-slate-500 uppercase mb-2">Latest</p>
          <h2 class="text-4xl font-extrabold tracking-[-0.06em] text-slate-900 leading-none mb-6">Now</h2>
          <ul class="divide-y divide-slate-900/20 border-y border-slate-900/20">
            <li class="py-4">
              <span class="editorial-tag mb-3">Focus</span>
              <p class="font-mono text-sm font-bold uppercase leading-snug text-slate-900">Linux, Docker &amp; Python automation</p>
            </li>
            <li class="py-4">
              <span class="editorial-tag mb-3">Status</span>
              <p class="font-mono text-sm font-bold uppercase leading-snug text-slate-900">Learning in public</p>
            </li>
            <li class="py-4">
              <span class="editorial-tag mb-3">Base</span>
              <p class="font-mono text-sm font-bold uppercase leading-snug text-slate-900">Bandung, Indonesia</p>
            </li>
          </ul>
          <figure class="mt-6 overflow-hidden rounded-2xl border border-slate-900/15">
            <Image
              src={heroImage1}
              alt="Reza Hakim Arafah"
              widths={[168, 296, 444]}
              sizes="(min-width: 1024px) 22vw, 100vw"
              loading="eager"
              decoding="async"
              fetchpriority="low"
              class="block aspect-[4/3] w-full object-cover"
            />
          </figure>
        </aside>

        <!-- Editorial links -->
        <div class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-slate-700">
          <a href="https://github.com/reezakim" target="_blank" rel="noopener" class="hover:text-brand-600 transition-colors">GitHub ↗</a>
          <a href="https://instagram.com/reezakim" target="_blank" rel="noopener" class="hover:text-brand-600 transition-colors">Instagram ↗</a>
          <a href="https://linkedin.com/in/rezahakim" target="_blank" rel="noopener" class="hover:text-brand-600 transition-colors">LinkedIn ↗</a>
        </div>
      </div>
    </main>

    <!-- About Section (Redesigned with Distinct Glass Cards for Each Topic) -->
    <section id="about" class="band-tint max-w-7xl mx-auto px-6 py-20 relative z-10">
      <!-- Section Header -->
      <div class="mb-12 reveal">
        <span class="sec-no">01</span>
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-pill text-brand-600 text-xs font-mono font-bold tracking-wider mb-3"
        >
          <span class="w-2 h-2 rounded-full bg-brand-500"></span>
          ABOUT ME
        </div>
        <h2
          class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3"
        >
          Background &amp; Expertise
        </h2>
        <p class="text-slate-600 max-w-2xl text-base font-medium">
          Mengenal latar belakang, cara kerja, dan fokus teknologi yang
          dipelajari di Infra Learning Lab.
        </p>
      </div>

      <!-- Background Main Card -->
      <div
        class="glass-card rounded-3xl p-8 mb-12 reveal tilt-card border-l-4 border-l-brand-500"
      >
        <div
          class="flex flex-col md:flex-row md:items-center justify-between gap-6"
        >
          <div>
            <span
              class="text-xs font-mono font-bold text-brand-600 uppercase tracking-wider block mb-2"
              >Education &amp; Origin</span
            >
            <h3 class="text-2xl font-bold text-slate-900 mb-3">
              Latar Belakang
            </h3>
            <p class="text-slate-700 text-base leading-relaxed max-w-3xl">
              Saya memiliki latar belakang pendidikan
              <strong class="text-slate-900 font-semibold"
                >Teknik Komputer &amp; Jaringan (TKJ)</strong
              >
              dan saat ini sedang melanjutkan studi
              <strong class="text-slate-900 font-semibold">Informatika</strong>.
              Pengalaman praktis di bidang jaringan mendorong passion saya dalam
              mendalami Linux, arsitektur server, otomasi, dan
              <strong class="text-slate-900 font-semibold"
                >infrastructure engineering</strong
              >.
            </p>
          </div>
          <div class="flex flex-wrap md:flex-col items-start gap-2.5 flex-shrink-0">
            <figure class="w-full max-w-[10rem] overflow-hidden rounded-2xl border border-slate-900/15">
              <Image
                src={heroImage2}
                alt="Reza Hakim Arafah"
                widths={[160, 320]}
                sizes="(min-width: 768px) 160px, 40vw"
                loading="lazy"
                decoding="async"
                class="block aspect-[4/5] w-full object-cover"
              />
            </figure>
            <span
              class="glass-pill px-4 py-2 rounded-xl text-xs font-mono font-bold text-slate-800 flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-cyan-500"></span> Network Engineer
            </span>
            <span
              class="glass-pill px-4 py-2 rounded-xl text-xs font-mono font-bold text-slate-800 flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
              Informatics Student
            </span>
            <span
              class="glass-pill px-4 py-2 rounded-xl text-xs font-mono font-bold text-slate-800 flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-purple-500"></span> Infra
              Enthusiast
            </span>
          </div>
        </div>
      </div>

      <!-- Subsection 1: How I Work (3 Distinct Modular Cards) -->
      <div class="mb-14">
        <div class="mb-6 reveal">
          <h3
            class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2"
          >
            <span class="w-3 h-3 rounded-full bg-blue-500"></span>
            How I Work &amp; Principles
          </h3>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <!-- Principle Card 1 -->
          <div
            class="glass-card rounded-3xl p-7 reveal tilt-card flex flex-col justify-between"
          >
            <div>
              <div
                class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-mono font-bold text-lg mb-5 shadow-lg shadow-blue-500/20"
              >
                01
              </div>
              <h4 class="text-lg font-bold text-slate-900 mb-2">
                Understand Fundamentals First
              </h4>
              <p class="text-slate-600 text-sm leading-relaxed">
                Saya lebih suka memahami bagaimana sebuah sistem bekerja di
                tingkat bawah (under the hood) sebelum mengandalkan tools atau
                otomasi serba instan.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/60">
              <span class="text-xs font-mono font-semibold text-blue-600"
                >#FirstPrinciples</span
              >
            </div>
          </div>

          <!-- Principle Card 2 -->
          <div
            class="glass-card rounded-3xl p-7 reveal tilt-card flex flex-col justify-between"
            style="transition-delay: 100ms"
          >
            <div>
              <div
                class="w-12 h-12 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-mono font-bold text-lg mb-5 shadow-lg shadow-cyan-500/20"
              >
                02
              </div>
              <h4 class="text-lg font-bold text-slate-900 mb-2">
                Structured Troubleshooting
              </h4>
              <p class="text-slate-600 text-sm leading-relaxed">
                Ketika menemukan masalah, saya terbiasa memecahnya menjadi
                bagian-bagian kecil, mendiagnosis akar masalahnya, lalu menguji
                solusinya secara bertahap.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/60">
              <span class="text-xs font-mono font-semibold text-cyan-600"
                >#IterativeTesting</span
              >
            </div>
          </div>

          <!-- Principle Card 3 -->
          <div
            class="glass-card rounded-3xl p-7 reveal tilt-card flex flex-col justify-between"
            style="transition-delay: 200ms"
          >
            <div>
              <div
                class="w-12 h-12 rounded-2xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center text-white font-mono font-bold text-lg mb-5 shadow-lg shadow-teal-500/20"
              >
                03
              </div>
              <h4 class="text-lg font-bold text-slate-900 mb-2">
                Living Documentation
              </h4>
              <p class="text-slate-600 text-sm leading-relaxed">
                Mendokumentasikan setiap proses &amp; temuan agar di kemudian
                hari suatu pekerjaan dapat direplikasi tanpa harus mengulangnya
                dari nol.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-white/60">
              <span class="text-xs font-mono font-semibold text-teal-600"
                >#DocumentOrItDidntHappen</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Subsection 2: Current Focus & Tech Stack (Separate Dedicated Cards for Each Tech Domain) -->
      <div class="mb-14">
        <div class="mb-6 reveal">
          <h3
            class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2"
          >
            <span class="w-3 h-3 rounded-full bg-purple-500"></span>
            Current Focus &amp; Tech Stack
          </h3>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Stack Card 1: Linux -->
          <div class="topic-orange glass-card rounded-3xl p-6 reveal tilt-card">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-600 font-bold font-mono text-sm"
              >
                <img
                  src="images/logo/linux.png"
                  alt="Linux"
                  class="w-6 h-6 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h4 class="font-bold text-slate-900 text-base">
                  Linux Administration
                </h4>
                <span class="text-[11px] font-mono text-slate-500"
                  >Core OS &amp; Hardening</span
                >
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Linux Foundation</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Web Server (Nginx)</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Server Hardening</span
              >
            </div>
          </div>

          <!-- Stack Card 2: Networking -->
          <div
            class="topic-blue glass-card rounded-3xl p-6 reveal tilt-card"
            style="transition-delay: 100ms"
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-600 font-bold font-mono text-sm"
              >
                <img
                  src="images/logo/network.png"
                  alt="Networking"
                  class="w-6 h-6 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h4 class="font-bold text-slate-900 text-base">Networking</h4>
                <span class="text-[11px] font-mono text-slate-500"
                  >Protocols &amp; Routing</span
                >
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >TCP/IP Stack</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >DNS Architecture</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Routing &amp; Net-tools</span
              >
            </div>
          </div>

          <!-- Stack Card 3: Automation & Python -->
          <div
            class="topic-emerald glass-card rounded-3xl p-6 reveal tilt-card"
            style="transition-delay: 200ms"
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 font-bold font-mono text-sm"
              >
                <img
                  src="images/logo/automation.png"
                  alt="Automation"
                  class="w-6 h-6 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h4 class="font-bold text-slate-900 text-base">
                  Automation &amp; Scripting
                </h4>
                <span class="text-[11px] font-mono text-slate-500"
                  >Bash &amp; Python</span
                >
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Bash Shell Scripting</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Python Automation</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >System Monitoring</span
              >
            </div>
          </div>

          <!-- Stack Card 4: Docker & Containers -->
          <div
            class="topic-sky glass-card rounded-3xl p-6 reveal tilt-card"
            style="transition-delay: 300ms"
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-600 font-bold font-mono text-sm"
              >
                <img
                  src="images/logo/containerization.png"
                  alt="Containerization"
                  class="w-6 h-6 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h4 class="font-bold text-slate-900 text-base">
                  Containerization
                </h4>
                <span class="text-[11px] font-mono text-slate-500"
                  >Docker &amp; Virtualization</span
                >
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Docker Containers</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >Docker Compose</span
              >
              <span
                class="glass-pill px-3 py-1 rounded-lg text-xs font-medium text-slate-700"
                >VMware Hypervisor</span
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Subsection 3: Trajectory & Future Direction Card -->
      <div
        class="glass-card rounded-3xl p-8 reveal tilt-card border-l-4 border-l-emerald-500"
      >
        <div
          class="flex flex-col md:flex-row md:items-center justify-between gap-6"
        >
          <div>
            <span
              class="text-xs font-mono font-bold text-emerald-600 uppercase tracking-wider block mb-2"
              >Long-term Vision</span
            >
            <h3 class="text-2xl font-bold text-slate-900 mb-3">
              Future Direction
            </h3>
            <p class="text-slate-700 text-base leading-relaxed max-w-3xl">
              Saya ingin berkembang menjadi
              <strong class="text-slate-900 font-semibold"
                >Infrastructure Engineer</strong
              >
              yang mampu merancang, mengoperasikan, mengotomasi, dan memelihara
              sistem yang <em>reliable</em>, <em>scalable</em>, dan
              <em>secure</em>.
              <strong class="text-slate-900 font-semibold"
                >Infra Learning Lab</strong
              >
              menjadi wadah dokumentasi proses tersebut melalui eksperimen
              praktis, project, dan pembelajaran berkelanjutan.
            </p>
          </div>
          <div class="flex-shrink-0">
            <span
              class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 font-mono font-bold text-xs"
            >
              <span
                class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              Reliable &amp; Secure Infrastructure
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Lab Section -->
    <section
      id="learning-lab"
      class="band-white max-w-7xl mx-auto px-6 py-20 relative z-10"
    >
      <div class="mb-12 reveal">
        <span class="sec-no">02</span>
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-pill text-brand-600 text-xs font-mono font-bold tracking-wider mb-3"
        >
          <span class="w-2 h-2 rounded-full bg-brand-500"></span>
          LEARNING LAB
        </div>
        <h2
          class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3"
        >
          Learning Lab
        </h2>
        <p class="text-slate-600 max-w-2xl text-base font-medium">
          Ruang eksperimen dan dokumentasi praktis administrasi server,
          jaringan, dan otomasi infrastruktur secara terstruktur.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Linux Lab Module Card -->
        <div
          class="glass-card rounded-3xl p-8 reveal tilt-card flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-400 via-blue-500 to-indigo-600 flex items-center justify-center mb-6 shadow-lg shadow-cyan-500/30"
            >
              <svg
                class="w-7 h-7 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                />
              </svg>
            </div>
            <span
              class="glass-pill px-3 py-1 rounded-lg text-cyan-800 font-mono text-xs font-semibold mb-3 inline-block"
              >Lab module</span
            >
            <h3 class="text-2xl font-bold text-slate-900 mb-3">Linux</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              Praktik langsung administrasi Linux, manajemen server, hardening,
              dan troubleshooting sistem secara bertahap.
            </p>
          </div>
          <div>
            <a
              href="/coming-soon/linux/"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-colors shadow-md group"
            >
              Explore Linux Lab
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="band-tint max-w-7xl mx-auto px-6 py-20 relative z-10">
      <div class="mb-12 reveal">
        <span class="sec-no">03</span>
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-pill text-brand-600 text-xs font-mono font-bold tracking-wider mb-3"
        >
          <span class="w-2 h-2 rounded-full bg-brand-500"></span>
          PROJECTS
        </div>
        <h2
          class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3"
        >
          Projects
        </h2>
        <p class="text-slate-600 max-w-2xl text-base font-medium">
          Project dan perkakas pendukung otomatisasi infrastruktur yang
          dikembangkan.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Healthcheck Card -->
        <div
          class="glass-card rounded-3xl p-8 reveal tilt-card flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center mb-6 shadow-lg shadow-amber-500/30"
            >
              <svg
