---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
    <!-- Hero Section -->
    <main
      class="relative max-w-7xl mx-auto px-6 pt-28 lg:pt-24 pb-20 min-h-screen flex flex-col justify-center"
    >
      <div class="grid lg:grid-cols-12 gap-12 items-center" id="home">
        <!-- Hero Text -->
        <div
          class="lg:col-span-7 flex flex-col items-start z-10 animate-fade-in-up"
        >
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.12]"
          >
            Reza Hakim Arafah <br />
            <span class="marker">Infrastructure Engineer</span>
          </h1>

          <p
            class="text-slate-700 text-lg leading-relaxed max-w-xl mb-8 font-medium"
          >
            Personal portfolio &amp; infrastructure learning lab yang
            mengeksplorasi manajemen server Linux, networking, otomasi, Docker,
            dan arsitektur sistem secara praktis.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <span class="magnetic-wrap" data-magnetic>
              <a
                href="coming-soon.html?from=learning-lab"
                class="mac-btn mac-btn-primary group inline-flex items-center justify-center rounded-[14px] px-7 py-3.5 text-sm font-semibold active:scale-[0.98] overflow-hidden relative"
              >
                Explore Learning Lab
                <svg
                  class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </a>
            </span>
            <span class="magnetic-wrap" data-magnetic>
              <a
                href="#contact"
                class="mac-btn inline-flex items-center justify-center rounded-[14px] px-7 py-3.5 text-sm font-semibold active:scale-[0.98]"
              >
                Contact Me
              </a>
            </span>
          </div>

          <!-- Hero Socials -->
          <div
            class="flex items-center gap-3 font-medium text-sm text-slate-700 mb-8"
          >
            <a
              href="https://github.com/reezakim"
              target="_blank"
              rel="noopener"
              class="glass-pill inline-flex items-center gap-2 px-4 py-2 rounded-xl hover:bg-white hover:text-slate-900 transition-all shadow-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.16.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.61 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.16a10.9 10.9 0 0 1 5.74 0c2.19-1.47 3.15-1.16 3.15-1.16.62 1.57.23 2.73.11 3.02.73.79 1.17 1.8 1.17 3.04 0 4.36-2.66 5.31-5.19 5.6.41.35.77 1.04.77 2.11 0 1.52-.01 2.75-.01 3.12 0 .3.2.66.79.55 4.5-1.5 7.76-5.76 7.76-10.78C23.02 5.24 18.27.5 12 .5Z"
                />
              </svg>
              <span>GitHub</span>
            </a>
            <a
              href="https://instagram.com/reezakim"
              target="_blank"
              rel="noopener"
              class="glass-pill inline-flex items-center gap-2 px-4 py-2 rounded-xl hover:bg-white hover:text-slate-900 transition-all shadow-sm"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                <circle cx="12" cy="12" r="4.3" />
                <circle
                  cx="17.4"
                  cy="6.6"
                  r="1.1"
                  fill="currentColor"
                  stroke="none"
                />
              </svg>
              <span>Instagram</span>
            </a>
            <a
              href="https://linkedin.com/in/rezahakim"
              target="_blank"
              rel="noopener"
              class="glass-pill inline-flex items-center gap-2 px-4 py-2 rounded-xl hover:bg-white hover:text-slate-900 transition-all shadow-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M4.98 3.5C4.98 4.88 3.9 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.5 8.5h4V23h-4V8.5Zm7.5 0h3.83v1.98h.05c.53-1 1.85-2.06 3.8-2.06 4.07 0 4.82 2.68 4.82 6.16V23h-4v-6.65c0-1.59-.03-3.63-2.21-3.63-2.22 0-2.56 1.73-2.56 3.52V23h-4V8.5Z"
                />
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>

          <!-- Session Status Panel -->
          <div class="glass-panel rounded-2xl p-4 w-full max-w-lg">
            <div
              class="flex items-center gap-2 mb-3 pb-2 border-b border-white/60"
            >
              <span
                class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span
                class="font-mono text-xs font-semibold tracking-wider text-slate-700 uppercase"
                >Session Status</span
              >
            </div>
            <dl class="grid grid-cols-2 gap-y-2 text-xs">
              <div>
                <dt class="text-slate-600 font-medium">Status</dt>
                <dd class="font-bold text-slate-900">Learning in public</dd>
              </div>
              <div>
                <dt class="text-slate-600 font-medium">Focus</dt>
                <dd class="font-bold text-slate-900">
                  Linux · Docker · Python
                </dd>
              </div>
              <div>
                <dt class="text-slate-600 font-medium">Base</dt>
                <dd class="font-bold text-slate-900">Bandung, ID</dd>
              </div>
              <div>
                <dt class="text-slate-600 font-medium">Mode</dt>
                <dd class="font-bold text-slate-900">Infra lab — active</dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Hero Visual: floating photos + macOS terminal window -->
        <div
          class="lg:col-span-5 relative z-10 w-full hero-visual"
          id="hero-visual"
        >
          <!-- Photo 1 — top-right edge (add images/hero-image1.jpg) -->
          <figure
            class="hero-photo hero-photo--tr"
            aria-label="Reza Hakim Arafah"
          >
            <img
              src="images/hero-image1.jpg"
              alt="Reza Hakim Arafah"
              width="128"
              height="128"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>

          <div class="mac-window animate-float tilt-card" id="hero-terminal">
            <div class="mac-titlebar">
              <div class="mac-traffic-lights" aria-hidden="true">
                <span class="mac-dot mac-dot--close" title="Close"></span>
                <span class="mac-dot mac-dot--minimize" title="Minimize"></span>
                <span class="mac-dot mac-dot--maximize" title="Maximize"></span>
              </div>
              <div
                class="font-mono text-[11px] font-medium text-[#86868b] tracking-wide"
              >
                root@infralab — zsh
              </div>
              <div class="w-[52px]"></div>
            </div>
            <div
              class="p-5 font-mono text-[11px] leading-relaxed text-[#1d1d1f] h-72 mac-terminal-body overflow-hidden"
              id="terminal-body"
            >
              <div class="text-[#007aff] font-semibold mb-1">
                Welcome to InfraLab Interactive Shell v2.0
              </div>
              <div class="text-[#86868b] mb-3">
                Initializing system lab environment... [OK]
              </div>
              <div id="typewriter"></div>
            </div>
          </div>

          <!-- Photo 2 — bottom-left edge (add images/hero-image2.jpg) -->
          <figure
            class="hero-photo hero-photo--bl"
            aria-label="Reza Hakim Arafah"
          >
            <img
              src="images/hero-image2.jpg"
              alt="Reza Hakim Arafah"
              width="148"
              height="148"
              loading="eager"
              decoding="async"
              fetchpriority="low"
            />
          </figure>
        </div>
      </div>
    </main>
</BaseLayout>
