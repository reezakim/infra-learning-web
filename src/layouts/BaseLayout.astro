---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  showNavbar?: boolean;
}

const {
  title = 'Reza Hakim Arafah | Infrastructure Engineer',
  description = 'Personal portfolio and infrastructure learning lab of Reza Hakim Arafah, exploring Linux, networking, automation, Docker, and infrastructure engineering.',
  showNavbar = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta
      property="og:image"
      content="https://reezakim.my.id/images/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://reezakim.my.id/images/og-image.png"
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <!-- Fonts — self-hosted, preload biar ga FOUC -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Reza Hakim Arafah",
        "jobTitle": "Infrastructure Engineer",
        "url": "https://reezakim.my.id/",
        "image": "https://reezakim.my.id/images/og-image.png",
        "sameAs": [
          "https://github.com/reezakim",
          "https://instagram.com/reezakim",
          "https://linkedin.com/in/rezahakim"
        ],
        "knowsAbout": [
          "Linux Administration",
          "Networking",
          "Automation & Scripting",
          "Docker",
          "Infrastructure Engineering"
        ]
      }
    </script>
  </head>
  <body
    class="antialiased min-h-screen bg-[#F7F7F5] dark:bg-[#0D0D0D] text-neutral-900 dark:text-neutral-100 font-sans selection:bg-[#ff3e00] selection:text-white"
  >
    {showNavbar && <Navbar />}

    <!-- Swiss Frame 3-Column Grid Container -->
    <div class="relative w-full min-h-screen grid grid-cols-1 xl:grid-cols-[64px_1fr_64px] border-x-0 xl:border-x border-[#E0E0DC] dark:border-[#262626] max-w-[1600px] mx-auto pt-14 lg:pt-0">
      <!-- Left Rail (Sticky Swiss Framing) -->
      <aside class="hidden xl:flex flex-col items-center justify-between py-12 border-r border-[#E0E0DC] dark:border-[#262626] select-none pointer-events-none sticky top-0 h-screen">
        <div class="font-mono text-[10px] tracking-[0.25em] uppercase text-neutral-400 dark:text-neutral-500 [writing-mode:vertical-lr] rotate-180">
          SYS.ID // RHA-INFRA-LAB
        </div>
        <div class="w-1.5 h-1.5 bg-[#ff3e00]"></div>
        <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-400 dark:text-neutral-500 [writing-mode:vertical-lr] rotate-180">
          SWISS STYLE FRAME // 2026
        </div>
      </aside>

      <!-- Center Main Content -->
      <div class="w-full min-w-0 flex flex-col justify-between">
        <div class="w-full">
          <slot />
        </div>
        <Footer />
      </div>

      <!-- Right Rail (Sticky Swiss Metrics/Nav indicator) -->
      <aside class="hidden xl:flex flex-col items-center justify-between py-12 border-l border-[#E0E0DC] dark:border-[#262626] select-none sticky top-0 h-screen">
        <div class="flex items-center gap-2 font-mono text-[10px] tracking-[0.25em] uppercase text-neutral-400 dark:text-neutral-500 [writing-mode:vertical-lr]">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full inline-block animate-pulse"></span>
          SYS.STATUS: ONLINE
        </div>
        <nav aria-label="Quick Rail Navigation" class="flex flex-col gap-6 font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 dark:text-neutral-400 [writing-mode:vertical-lr]">
          <a href="/#home" class="hover:text-[#ff3e00] dark:hover:text-[#ff3e00] transition-colors">HOME</a>
          <a href="/#about" class="hover:text-[#ff3e00] dark:hover:text-[#ff3e00] transition-colors">ABOUT</a>
          <a href="/learning/" class="hover:text-[#ff3e00] dark:hover:text-[#ff3e00] transition-colors">LABS</a>
          <a href="/#contact" class="hover:text-[#ff3e00] dark:hover:text-[#ff3e00] transition-colors">CONTACT</a>
        </nav>
        <div class="font-mono text-[10px] tracking-[0.2em] text-neutral-400 dark:text-neutral-500 [writing-mode:vertical-lr]">
          LAT: 52ms
        </div>
      </aside>
    </div>

    <script is:inline src="/js/main.js"></script>
  </body>
</html>
