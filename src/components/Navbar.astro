      <span class="font-mono text-xs font-semibold tracking-widest uppercase text-neutral-900 dark:text-white">REZA HAKIM // INFRASTRUCTURE LAB</span>
    </a>
    
    <nav class="flex items-center gap-8 font-mono text-xs tracking-widest uppercase text-neutral-600 dark:text-neutral-400">
