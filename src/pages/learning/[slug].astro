---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('learning');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const TOPIC_LABEL = {
  linux: 'LINUX',
  network: 'NETWORK',
  automation: 'AUTOMATION',
  containerization: 'CONTAINERIZATION',
};

const STATUS_LABEL = {
  done: 'DONE',
  ongoing: 'ONGOING',
};
---

<BaseLayout
  title={`${entry.data.title} // Learning Lab`}
  description={entry.data.description}
>
  <main class="w-full flex flex-col">
    <!-- Header / Meta Header -->
    <div class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-8 sm:py-12 bg-white dark:bg-[#141414]">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 sm:mb-8 font-mono text-[11px] sm:text-xs text-neutral-500">
        <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <li><a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">HOME</a></li>
          <li class="text-neutral-300 dark:text-neutral-700">/</li>
          <li><a href="/learning/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">LEARNING_LAB</a></li>
          <li class="text-neutral-300 dark:text-neutral-700">/</li>
          <li aria-current="page" class="text-[#ff3e00] font-bold">{TOPIC_LABEL[entry.data.topic]}</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3 font-mono text-[11px] sm:text-xs mb-3 sm:mb-4">
        <span class="px-2 py-0.5 border border-[#ff3e00]/30 bg-[#ff3e00]/5 text-[#ff3e00] font-bold uppercase">
          {TOPIC_LABEL[entry.data.topic]}
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">|</span>
        <span class:list={[entry.data.status === 'done' ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400', 'font-semibold uppercase']}>
          STATUS: {STATUS_LABEL[entry.data.status]}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-neutral-900 dark:text-white mb-4 sm:mb-6 leading-[1.15] max-w-4xl">
        {entry.data.title}
      </h1>

      <p class="text-neutral-700 dark:text-neutral-300 text-sm sm:text-base lg:text-lg leading-relaxed max-w-3xl mb-6 sm:mb-8">
        {entry.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-x-4 sm:gap-x-6 gap-y-2 font-mono text-[11px] sm:text-xs text-neutral-500 pt-4 sm:pt-6 border-t border-[#E0E0DC] dark:border-[#262626]">
        <span>PUBLISHED: {entry.data.date.toISOString().slice(0, 10)}</span>
        {entry.data.tags.length > 0 && (
          <span class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            {entry.data.tags.map((tag) => (
              <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D] text-neutral-700 dark:text-neutral-300 uppercase">
                #{tag}
              </span>
            ))}
          </span>
        )}
      </div>
    </div>

    <!-- Article Content Spread -->
    <div class="px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-[#F7F7F5] dark:bg-[#0D0D0D]">
      <article
        class="prose prose-neutral dark:prose-invert max-w-4xl
          prose-headings:tracking-tight prose-headings:font-black prose-headings:uppercase
          prose-p:leading-relaxed prose-p:text-neutral-800 dark:prose-p:text-neutral-200
          prose-a:text-[#ff3e00] prose-a:font-bold prose-a:no-underline hover:prose-a:underline
          prose-strong:font-bold prose-strong:text-neutral-900 dark:prose-strong:text-white
          prose-code:font-mono prose-code:text-xs prose-code:bg-white dark:prose-code:bg-[#141414] prose-code:px-1.5 prose-code:py-0.5 prose-code:border prose-code:border-[#E0E0DC] dark:prose-code:border-[#262626] prose-code:rounded-none prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-black prose-pre:border prose-pre:border-[#262626] prose-pre:rounded-none prose-pre:p-4 sm:prose-pre:p-6
          prose-hr:border-[#E0E0DC] dark:prose-hr:border-[#262626]"
      >
        <Content />
      </article>

      <div class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-[#E0E0DC] dark:border-[#262626] max-w-4xl">
        <a
          href="/learning/"
          class="inline-flex items-center gap-2 px-5 sm:px-6 py-2.5 sm:py-3 border border-neutral-900 dark:border-white bg-white dark:bg-[#141414] text-xs font-mono font-bold tracking-widest uppercase hover:bg-neutral-900 hover:text-white dark:hover:bg-white dark:hover:text-neutral-900 transition-colors"
        >
          ← BACK TO LEARNING LAB
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

