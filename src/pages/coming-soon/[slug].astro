---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'learning-lab' } },
    { params: { slug: 'linux' } },
    { params: { slug: 'projects' } },
    { params: { slug: 'healthcheck' } },
  ];
}

const CONTENT = {
  'learning-lab': {
    badge: 'LEARNING LAB',
    title: 'Learning Lab',
    description:
      'Ruang eksperimen dan dokumentasi praktis administrasi server, jaringan, dan otomatisasi infrastruktur sedang disiapkan. Modul-modul lab akan segera tersedia secara bertahap.',
    status: 'Lab environment — provisioning',
    accent: 'from-cyan-400 via-blue-500 to-indigo-600 shadow-cyan-500/30',
    breadcrumb: [
      { label: 'Home', href: '/' },
      { label: 'Learning Lab', current: true },
    ],
  },
  linux: {
    badge: 'LAB MODULE',
    title: 'Linux Learning Lab',
    description:
      'Modul pembelajaran Linux — administrasi server, manajemen user, hardening, dan troubleshooting — masih dalam tahap pengembangan dan dokumentasi.',
    status: 'Module build — in progress',
    accent: 'from-cyan-400 via-blue-500 to-indigo-600 shadow-cyan-500/30',
    breadcrumb: [
      { label: 'Home', href: '/' },
      { label: 'Learning Lab', href: '/coming-soon/learning-lab/' },
      { label: 'Linux', current: true },
    ],
  },
  projects: {
    badge: 'PROJECTS',
    title: 'Projects',
    description:
      'Koleksi project dan perkakas otomatisasi infrastruktur sedang dikembangkan. Setiap tool akan dirilis dengan dokumentasi dan repositori yang dapat digunakan langsung.',
    status: 'Pipeline — active development',
    accent: 'from-indigo-400 via-purple-500 to-violet-600 shadow-indigo-500/30',
    breadcrumb: [
      { label: 'Home', href: '/' },
      { label: 'Projects', current: true },
    ],
  },
  healthcheck: {
    badge: 'TOOL',
    title: 'Healthcheck',
    description:
      'Perkakas monitoring dan validasi kesehatan server & layanan secara otomatis. Fitur health probe, alerting, dan laporan status sedang dalam pengembangan.',
    status: 'v0.1 — building core engine',
    accent: 'from-amber-400 to-orange-500 shadow-amber-500/30',
    breadcrumb: [
      { label: 'Home', href: '/' },
      { label: 'Projects', href: '/coming-soon/projects/' },
      { label: 'Healthcheck', current: true },
    ],
  },
};

const { slug } = Astro.params;
const data = CONTENT[slug];

const ICONS = {
  server: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>',
  folder: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>',
  shield: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
};
const icon = ICONS[slug === 'projects' ? 'folder' : slug === 'healthcheck' ? 'shield' : 'server'];
---

<BaseLayout
  title={`${data.title} — Coming Soon | InfraLab`}
  description={data.description}
  showNavbar={false}
>
  <nav class="fixed top-0 w-full z-50 glass-nav">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 via-blue-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-cyan-500/30 text-white font-bold font-mono text-lg">
          RHA
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-slate-900 tracking-tight text-lg leading-none">InfraLab.</span>
          <span class="text-[10px] font-mono text-slate-600 font-medium mt-0.5">Reza Hakim Arafah</span>
        </div>
      </a>
      <a href="/" class="glass-pill px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-900 hover:bg-white hover:shadow-lg transition-all">Back to Home</a>
    </div>
  </nav>

  <main class="relative max-w-3xl mx-auto px-6 pt-32 pb-20 min-h-screen flex flex-col justify-center">
    <nav aria-label="Breadcrumb" class="mb-8 animate-fade-in-up">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-xs text-slate-600">
        {data.breadcrumb.map((item, i) => (
          <>
            {i > 0 && <li class="text-slate-400" aria-hidden="true">/</li>}
            {item.current ? (
              <li aria-current="page" class="glass-pill px-3.5 py-1.5 rounded-xl text-brand-600 font-bold">{item.label}</li>
            ) : (
              <li><a href={item.href} class="glass-pill px-3.5 py-1.5 rounded-xl hover:bg-white transition-colors">{item.label}</a></li>
            )}
          </>
        ))}
      </ol>
    </nav>

    <div class="glass-panel rounded-3xl p-8 lg:p-12 text-center animate-fade-in-up">
      <div class="inline-flex items-center gap-2 rounded-full glass-pill px-4 py-1.5 font-mono text-xs font-bold text-brand-600 shadow-sm mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse-soft"></span>
        {data.badge}
      </div>

      <div class={`w-16 h-16 rounded-2xl mx-auto mb-6 flex items-center justify-center shadow-lg bg-gradient-to-br ${data.accent}`}>
        <Fragment set:html={icon} />
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        {data.title}
      </h1>

      <p class="text-slate-600 text-base leading-relaxed max-w-lg mx-auto mb-8 font-medium">
        {data.description}
      </p>

      <div class="glass-pill inline-flex items-center justify-center gap-2 mx-auto px-5 py-3 rounded-2xl font-mono text-xs font-semibold text-slate-700 mb-10 w-fit">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Status: {data.status}</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-colors shadow-md group">
          <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Kembali ke Home
        </a>
        <a href="/#contact" class="glass-pill inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-slate-800 hover:bg-white/80 transition-all shadow-sm">
          Hubungi Saya
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
