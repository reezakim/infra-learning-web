---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage1 from '../assets/hero-image1.jpg';
import heroImage2 from '../assets/hero-image2.jpg';
---

<BaseLayout
  title="Reza Hakim Arafah // Infrastructure Engineer & Systems Lab"
  description="Swiss Style Infrastructure Portfolio & Knowledge Base of Reza Hakim Arafah. Linux hardening, networking, homelab architecture, Docker, and automation."
>
  <main id="home" class="w-full flex flex-col">
    <!-- Top System Telemetry Bar -->
    <div class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-4 font-mono text-[10px] sm:text-[11px] text-neutral-500 dark:text-neutral-400 bg-white/60 dark:bg-black/30">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="inline-flex items-center gap-1.5 text-[#ff3e00] font-semibold">
          <span class="w-1.5 h-1.5 bg-[#ff3e00] animate-pulse"></span>
          SYS.PULSE: OK
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">|</span>
        <span>NODE: ID-BDG-01</span>
        <span class="text-neutral-300 dark:text-neutral-700">|</span>
        <span>KERNEL: 6.8.0-GENERIC</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-4">
        <span>LOC: BANDUNG, ID (UTC+7)</span>
        <span class="hidden sm:inline text-neutral-300 dark:text-neutral-700">|</span>
        <span class="hidden sm:inline">SWISS // BRUTALIST</span>
      </div>
    </div>

    <!-- Hero Header Spread -->
    <section class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-10 sm:py-16 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-7 flex flex-col items-start justify-between h-full">
        <div>
          <div class="inline-flex items-center gap-2 font-mono text-[11px] sm:text-xs font-semibold tracking-widest text-[#ff3e00] uppercase mb-4 sm:mb-6 border border-[#ff3e00]/30 px-2.5 py-1 bg-[#ff3e00]/5">
            [00] INFRASTRUCTURE &amp; DEVOPS LAB
          </div>
          <h1 class="text-3xl sm:text-5xl lg:text-7xl font-black uppercase tracking-tighter leading-[0.95] text-neutral-900 dark:text-white mb-6 sm:mb-8">
            REZA HAKIM<br />
            <span class="text-neutral-400 dark:text-neutral-600 font-light">//</span> ARAFAH
          </h1>
          <p class="text-sm sm:text-base lg:text-lg text-neutral-700 dark:text-neutral-300 font-normal leading-relaxed max-w-2xl mb-6 sm:mb-8">
            Infrastructure engineer &amp; informatics student focusing on <strong class="font-bold text-neutral-900 dark:text-white">Linux server hardening</strong>, network protocols, containerized homelabs, and automated deployment pipelines.
          </p>
        </div>

        <div class="w-full grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 pt-6 border-t border-[#E0E0DC] dark:border-[#262626] font-mono text-xs">
          <div class="border border-[#E0E0DC] dark:border-[#262626] p-2.5 sm:p-3 bg-white dark:bg-[#141414]">
            <span class="text-neutral-400 text-[9px] sm:text-[10px] block uppercase">01. ROLE</span>
            <span class="font-bold text-[11px] sm:text-xs text-neutral-900 dark:text-neutral-100">INFRA ENGINEER</span>
          </div>
          <div class="border border-[#E0E0DC] dark:border-[#262626] p-2.5 sm:p-3 bg-white dark:bg-[#141414]">
            <span class="text-neutral-400 text-[9px] sm:text-[10px] block uppercase">02. OS FOCUS</span>
            <span class="font-bold text-[11px] sm:text-xs text-neutral-900 dark:text-neutral-100">DEBIAN / UBUNTU</span>
          </div>
          <div class="border border-[#E0E0DC] dark:border-[#262626] p-2.5 sm:p-3 bg-white dark:bg-[#141414]">
            <span class="text-neutral-400 text-[9px] sm:text-[10px] block uppercase">03. RUNTIME</span>
            <span class="font-bold text-[11px] sm:text-xs text-neutral-900 dark:text-neutral-100">DOCKER COMPOSE</span>
          </div>
          <div class="border border-[#E0E0DC] dark:border-[#262626] p-2.5 sm:p-3 bg-white dark:bg-[#141414]">
            <span class="text-neutral-400 text-[9px] sm:text-[10px] block uppercase">04. SCRIPTING</span>
            <span class="font-bold text-[11px] sm:text-xs text-neutral-900 dark:text-neutral-100">BASH / PYTHON</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Homelab Live Pulse / Metrics Panel Widget -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-4 sm:p-6 shadow-none">
          <div class="flex items-center justify-between border-b border-[#E0E0DC] dark:border-[#262626] pb-3 mb-4 font-mono text-xs">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-emerald-500 rounded-none inline-block animate-pulse"></span>
              <span class="font-bold tracking-wider uppercase text-neutral-900 dark:text-neutral-100 text-[11px] sm:text-xs">HOMELAB LIVE PULSE</span>
            </div>
            <span class="text-neutral-400 text-[10px]">POLL: 10s</span>
          </div>

          <div class="flex flex-col gap-3 font-mono text-xs">
            <div class="flex justify-between items-center text-neutral-600 dark:text-neutral-400 text-[11px] sm:text-xs">
              <span>HOST_UPTIME</span>
              <span class="font-bold text-neutral-900 dark:text-neutral-100">148 DAYS, 14:22:08</span>
            </div>
            
            <div class="space-y-1">
              <div class="flex justify-between text-[10px] sm:text-[11px] text-neutral-500">
                <span>CPU LOAD (8 CORES)</span>
                <span>18.4%</span>
              </div>
              <div class="w-full bg-neutral-200 dark:bg-neutral-800 h-1.5">
                <div class="bg-[#ff3e00] h-1.5 w-[18.4%]"></div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-[10px] sm:text-[11px] text-neutral-500">
                <span>RAM UTILIZATION</span>
                <span>6.2 GB / 16.0 GB (38.7%)</span>
              </div>
              <div class="w-full bg-neutral-200 dark:bg-neutral-800 h-1.5">
                <div class="bg-neutral-900 dark:bg-neutral-100 h-1.5 w-[38.7%]"></div>
              </div>
            </div>
          </div>

          <!-- Active Services Grid -->
          <div class="mt-6 pt-4 border-t border-[#E0E0DC] dark:border-[#262626]">
            <span class="font-mono text-[10px] text-neutral-400 uppercase tracking-widest block mb-3">// ACTIVE HOMELAB SERVICES</span>
            <div class="grid grid-cols-2 gap-2 font-mono text-[10px] sm:text-[11px]">
              <div class="flex items-center justify-between p-2 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">
                <span>NGINX_PROXY</span>
                <span class="text-emerald-500 font-bold">200 OK</span>
              </div>
              <div class="flex items-center justify-between p-2 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">
                <span>DOCKER_DAEMON</span>
                <span class="text-emerald-500 font-bold">RUNNING</span>
              </div>
              <div class="flex items-center justify-between p-2 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">
                <span>GITEA_SERVER</span>
                <span class="text-emerald-500 font-bold">ONLINE</span>
              </div>
              <div class="flex items-center justify-between p-2 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">
                <span>ADGUARD_DNS</span>
                <span class="text-emerald-500 font-bold">ACTIVE</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Profile Card with Picture -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-3 sm:p-4 flex items-center gap-3 sm:gap-4">
          <figure class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 border border-[#E0E0DC] dark:border-[#262626] overflow-hidden">
            <Image
              src={heroImage1}
              alt="Reza Hakim Arafah"
              widths={[160]}
              sizes="(min-width: 640px) 80px, 64px"
              loading="eager"
              class="w-full h-full object-cover grayscale contrast-125"
            />
          </figure>
          <div class="flex flex-col">
            <span class="font-mono text-[9px] sm:text-[10px] text-neutral-400 uppercase tracking-wider">OPERATOR PROFILE</span>
            <h2 class="text-xs sm:text-sm font-bold text-neutral-900 dark:text-neutral-100 uppercase">Reza Hakim Arafah</h2>
            <p class="font-mono text-[10px] sm:text-[11px] text-neutral-500">Student &amp; Network Engineer · Bandung, ID</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Architecture Viewer (ASCII / Topology Map) -->
    <section class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-[#F7F7F5] dark:bg-[#0D0D0D]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
        <div>
          <span class="font-mono text-[11px] text-[#ff3e00] font-semibold tracking-widest uppercase block mb-1">[01] ARCHITECTURE TOPOLOGY</span>
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900 dark:text-white">Homelab Traffic Flow</h2>
        </div>
        <div class="font-mono text-[10px] sm:text-xs text-neutral-500 flex items-center gap-1.5">
          <span class="inline-block sm:hidden text-[#ff3e00]">← GESER HORIZONTAL →</span>
          <span class="hidden sm:inline">TYPE: REVERSE_PROXY_INGRESS // ZERO_TRUST_TUNNEL</span>
        </div>
      </div>

      <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-4 sm:p-8 font-mono overflow-x-auto" style="-webkit-overflow-scrolling: touch;">
        <pre class="text-[11px] sm:text-[13px] leading-relaxed text-neutral-800 dark:text-neutral-200">
+--------------------+        HTTPS (443)        +--------------------------+
|  CLIENT / BROWSER  | =========================&gt; |  CLOUDFLARE EDGE DNS/WAF |
+--------------------+                            +--------------------------+
                                                               ||
                                                       TUNNEL / PROXY PASS
                                                               \/
+-----------------------------------------------------------------------------------------+
| HOMELAB HOST: ubuntu-server-01 (192.168.1.100)                                          |
|                                                                                         |
|  +-----------------------------------------------------------------------------------+  |
|  | NGINX REVERSE PROXY (SSL Termination, Rate Limiting, Header Hardening)             |  |
|  +-----------------------------------------------------------------------------------+  |
|         |                                      |                                  |     |
|         v                                      v                                  v     |
|  +-------------------+               +-------------------+              +------------+  |
|  | DOCKER: GITEA     |               | DOCKER: ADGUARD   |              | DOCS / LAB |  |
|  | (Git Repo Server) |               | (DNS Sinkhole)    |              | (Astro SSG)|  |
|  | Port: :3000       |               | Port: :53/:3001   |              | Port: :4321|  |
|  +-------------------+               +-------------------+              +------------+  |
+-----------------------------------------------------------------------------------------+
        </pre>
      </div>
    </section>

    <!-- About & Engineering Principles Section -->
    <section id="about" class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-white dark:bg-[#141414]">
      <div class="mb-8 sm:mb-12">
        <span class="font-mono text-[11px] text-[#ff3e00] font-semibold tracking-widest uppercase block mb-1">[02] ENGINEERING METHODOLOGY</span>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900 dark:text-white mb-2 sm:mb-3">Background &amp; How I Work</h2>
        <p class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm max-w-2xl leading-relaxed">
          Memadukan latar belakang praktis Teknik Komputer &amp; Jaringan (TKJ) dan studi Informatika untuk membangun sistem yang tangguh, reproducible, dan terdokumentasi rapi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <!-- Principle 1 -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] p-5 sm:p-6 bg-[#F7F7F5] dark:bg-[#0D0D0D] flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center font-mono text-[11px] text-neutral-400 mb-4 pb-2 border-b border-[#E0E0DC] dark:border-[#262626]">
              <span>PRINCIPLE // 01</span>
              <span>UNDER_THE_HOOD</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white uppercase mb-2">Understand Fundamentals</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Memahami cara kerja sistem di level kernel, network socket, dan systemd service sebelum bergantung pada automation tooling atau abstraksi level tinggi.
            </p>
          </div>
          <div class="mt-6 pt-2 font-mono text-[10px] text-[#ff3e00] uppercase tracking-wider">
            TAG: #FIRST_PRINCIPLES
          </div>
        </div>

        <!-- Principle 2 -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] p-5 sm:p-6 bg-[#F7F7F5] dark:bg-[#0D0D0D] flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center font-mono text-[11px] text-neutral-400 mb-4 pb-2 border-b border-[#E0E0DC] dark:border-[#262626]">
              <span>PRINCIPLE // 02</span>
              <span>DIAGNOSTICS</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white uppercase mb-2">Structured Troubleshooting</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Mendiagnosis kendala dengan membedah layer OSI, memeriksa system journal log (journalctl/dmesg), dan mengisolasi variabel penyebab secara metodis.
            </p>
          </div>
          <div class="mt-6 pt-2 font-mono text-[10px] text-[#ff3e00] uppercase tracking-wider">
            TAG: #ISOLATE_AND_VERIFY
          </div>
        </div>

        <!-- Principle 3 -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] p-5 sm:p-6 bg-[#F7F7F5] dark:bg-[#0D0D0D] flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center font-mono text-[11px] text-neutral-400 mb-4 pb-2 border-b border-[#E0E0DC] dark:border-[#262626]">
              <span>PRINCIPLE // 03</span>
              <span>REPRODUCIBILITY</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white uppercase mb-2">Living Documentation</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Mendokumentasikan konfigurasi dan temuan lab agar setiap deployment dan perbaikan dapat direproduksi secara instan tanpa mengulang dari nol.
            </p>
          </div>
          <div class="mt-6 pt-2 font-mono text-[10px] text-[#ff3e00] uppercase tracking-wider">
            TAG: #DOCUMENT_EVERYTHING
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Matrix -->
    <section class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-[#F7F7F5] dark:bg-[#0D0D0D]">
      <div class="mb-8">
        <span class="font-mono text-[11px] text-[#ff3e00] font-semibold tracking-widest uppercase block mb-1">[03] TECH STACK MATRIX</span>
        <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900 dark:text-white">Core Competencies &amp; Tooling</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Linux -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 sm:p-6">
          <div class="font-mono text-xs text-neutral-400 mb-3 pb-2 border-b border-[#E0E0DC] dark:border-[#262626] flex justify-between">
            <span>DOMAIN: 01</span>
            <span class="text-neutral-900 dark:text-white font-bold">LINUX</span>
          </div>
          <h4 class="font-bold text-sm uppercase text-neutral-900 dark:text-white mb-2">Linux Administration</h4>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">Hardening, SSH key auth, UFW firewall, systemd services, user permissions.</p>
          <div class="flex flex-wrap gap-1 font-mono text-[10px]">
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">DEBIAN</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">UBUNTU</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">SYSTEMD</span>
          </div>
        </div>

        <!-- Networking -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 sm:p-6">
          <div class="font-mono text-xs text-neutral-400 mb-3 pb-2 border-b border-[#E0E0DC] dark:border-[#262626] flex justify-between">
            <span>DOMAIN: 02</span>
            <span class="text-neutral-900 dark:text-white font-bold">NETWORKING</span>
          </div>
          <h4 class="font-bold text-sm uppercase text-neutral-900 dark:text-white mb-2">Network Architecture</h4>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">TCP/IP, subnetting, DNS resolution, Wireguard VPN, reverse proxy routing.</p>
          <div class="flex flex-wrap gap-1 font-mono text-[10px]">
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">TCP/IP</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">DNS</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">NGINX</span>
          </div>
        </div>

        <!-- Containerization -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 sm:p-6">
          <div class="font-mono text-xs text-neutral-400 mb-3 pb-2 border-b border-[#E0E0DC] dark:border-[#262626] flex justify-between">
            <span>DOMAIN: 03</span>
            <span class="text-neutral-900 dark:text-white font-bold">CONTAINERS</span>
          </div>
          <h4 class="font-bold text-sm uppercase text-neutral-900 dark:text-white mb-2">Docker &amp; Virtualization</h4>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">Multi-container Docker Compose architectures, volume backups, bridge networks.</p>
          <div class="flex flex-wrap gap-1 font-mono text-[10px]">
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">DOCKER</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">COMPOSE</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">VMWARE</span>
          </div>
        </div>

        <!-- Automation -->
        <div class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 sm:p-6">
          <div class="font-mono text-xs text-neutral-400 mb-3 pb-2 border-b border-[#E0E0DC] dark:border-[#262626] flex justify-between">
            <span>DOMAIN: 04</span>
            <span class="text-neutral-900 dark:text-white font-bold">AUTOMATION</span>
          </div>
          <h4 class="font-bold text-sm uppercase text-neutral-900 dark:text-white mb-2">Scripting &amp; Monitoring</h4>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 mb-4 leading-relaxed">Automated bash backup scripts, healthcheck probes, cron triggers, telemetry.</p>
          <div class="flex flex-wrap gap-1 font-mono text-[10px]">
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">BASH</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">PYTHON</span>
            <span class="px-2 py-0.5 border border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">CRON</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Learning Lab & Projects Section -->
    <section class="px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-white dark:bg-[#141414]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="font-mono text-[11px] text-[#ff3e00] font-semibold tracking-widest uppercase block mb-1">[04] DOCUMENTATION LABS</span>
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-neutral-900 dark:text-white">Hands-on Infrastructure Guides</h2>
        </div>
        <a href="/learning/" class="font-mono text-xs uppercase tracking-widest text-[#ff3e00] hover:underline flex items-center gap-1 font-bold">
          VIEW ALL LABS →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <!-- Lab Article Preview 1 -->
        <a href="/learning/multi-user-server-hardening/" class="border border-[#E0E0DC] dark:border-[#262626] p-5 sm:p-6 bg-[#F7F7F5] dark:bg-[#0D0D0D] hover:border-neutral-900 dark:hover:border-white transition-colors flex flex-col justify-between group">
          <div>
            <div class="flex justify-between items-center font-mono text-[11px] text-neutral-400 mb-4 pb-2 border-b border-[#E0E0DC] dark:border-[#262626]">
              <span class="text-[#ff3e00] font-bold">TOPIC: LINUX</span>
              <span>STATUS: DONE</span>
            </div>
