<!-- Mobile & Tablet Navigation -->
<header class="fixed top-0 left-0 right-0 z-50 lg:hidden bg-[#F7F7F5]/95 dark:bg-[#0D0D0D]/95 backdrop-blur-md border-b border-[#E0E0DC] dark:border-[#262626]" id="mobile-nav">
  <div class="flex items-center justify-between px-4 sm:px-6 h-14">
    <a href="/#home" class="flex items-center gap-2">
      <span class="font-mono text-[11px] font-bold px-1.5 py-0.5 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900">RHA</span>
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-neutral-900 dark:text-white">INFRA // LAB</span>
    </a>
    <button
      id="menu-btn"
      type="button"
      aria-label="Buka menu navigasi"
      aria-controls="mobile-menu-wrap"
      aria-expanded="false"
      class="p-2 border border-[#E0E0DC] dark:border-[#262626] text-neutral-800 dark:text-neutral-200 bg-white dark:bg-[#141414]"
    >
      <svg class="menu-icon-open w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="menu-icon-close w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>
  
  <div id="mobile-menu-wrap" class="hidden px-4 sm:px-6 pb-6 pt-3 border-t border-[#E0E0DC] dark:border-[#262626] bg-[#F7F7F5] dark:bg-[#0D0D0D]">
    <div class="flex flex-col gap-2 font-mono text-xs uppercase tracking-wider">
      <a href="/#home" class="py-2.5 px-2 border-b border-[#E0E0DC] dark:border-[#262626] text-neutral-800 dark:text-neutral-200 hover:text-[#ff3e00]">01 // HOME</a>
      <a href="/#about" class="py-2.5 px-2 border-b border-[#E0E0DC] dark:border-[#262626] text-neutral-800 dark:text-neutral-200 hover:text-[#ff3e00]">02 // ABOUT</a>
      <a href="/learning/" class="py-2.5 px-2 border-b border-[#E0E0DC] dark:border-[#262626] text-neutral-800 dark:text-neutral-200 hover:text-[#ff3e00]">03 // LEARNING LAB</a>
      <a href="/#contact" class="py-2.5 px-2 text-neutral-800 dark:text-neutral-200 hover:text-[#ff3e00]">04 // CONTACT</a>
    </div>
  </div>
</header>

<!-- Desktop top header bar -->
