---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('learning')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const TOPIC_LABEL = {
  linux: 'LINUX',
  network: 'NETWORK',
  automation: 'AUTOMATION',
  containerization: 'CONTAINERIZATION',
};
---

<BaseLayout
  title="Learning Lab // Documentation & Infrastructure Guides"
  description="Dokumentasi lab belajar infrastruktur: Linux hardening, networking, automation, dan containerization."
>
  <main class="w-full flex flex-col">
    <!-- Section Header -->
    <div class="border-b border-[#E0E0DC] dark:border-[#262626] px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-white dark:bg-[#141414]">
      <div class="max-w-4xl">
        <span class="font-mono text-[11px] sm:text-xs text-[#ff3e00] font-semibold tracking-widest uppercase block mb-2">[LABS // KNOWLEDGE BASE]</span>
        <h1 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-neutral-900 dark:text-white mb-3 sm:mb-4">
          Learning Lab Guides
        </h1>
        <p class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-base leading-relaxed">
          Dokumentasi teknis praktis mengenai konfigurasi Linux, setup reverse proxy, arsitektur homelab, dan otomasi sistem. Setiap panduan dirancang agar dapat direplikasi secara langsung.
        </p>
      </div>
    </div>

    <!-- Labs Grid -->
    <div class="px-4 sm:px-8 lg:px-12 py-10 sm:py-16 bg-[#F7F7F5] dark:bg-[#0D0D0D]">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {entries.map((entry) => (
          <a href={`/learning/${entry.id}/`} class="border border-[#E0E0DC] dark:border-[#262626] bg-white dark:bg-[#141414] p-5 sm:p-6 hover:border-neutral-900 dark:hover:border-white transition-colors flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4 font-mono text-[10px] sm:text-[11px] pb-2 border-b border-[#E0E0DC] dark:border-[#262626]">
                <span class="text-[#ff3e00] font-bold">{TOPIC_LABEL[entry.data.topic]}</span>
                <span class:list={[entry.data.status === 'done' ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400', 'font-bold uppercase']}>
                  STATUS: {entry.data.status}
                </span>
              </div>
              <h2 class="text-lg sm:text-xl font-bold uppercase text-neutral-900 dark:text-white mb-2 sm:mb-3 group-hover:text-[#ff3e00] transition-colors leading-snug">
                {entry.data.title}
              </h2>
              <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed line-clamp-3">
                {entry.data.description}
              </p>
            </div>
            
            <div class="mt-6 pt-4 border-t border-[#E0E0DC] dark:border-[#262626] flex items-center justify-between font-mono text-[10px] sm:text-[11px]">
              <span class="text-neutral-500">{entry.data.date.toISOString().slice(0, 10)}</span>
              <span class="font-bold text-neutral-900 dark:text-white">READ GUIDE →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

